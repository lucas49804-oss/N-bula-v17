local fc = setmetatable({}, {__mode="k"})
local function C(f)
    local c = fc[f]
    if not c then c = {}; fc[f] = c end
    return c
end
local function vis(f, on)
    local c = C(f)
    if c.vis ~= on then c.vis = on; f.Visible = on end
end
local function rect(f,x,y,w,h,col)
    x = math.floor(x+0.5); y = math.floor(y+0.5)
    w = math.max(math.floor(w+0.5),1); h = math.max(math.floor(h+0.5),1)
    local c = C(f)
    if c.x ~= x or c.y ~= y or c.w ~= w or c.h ~= h then
        c.x, c.y, c.w, c.h = x, y, w, h
        f.Position = UDim2.fromOffset(x + w/2, y + h/2)
        f.Size = UDim2.fromOffset(w, h)
    end
    if c.col ~= col then c.col = col; f.BackgroundColor3 = col end
    if c.vis ~= true then c.vis = true; f.Visible = true end
end
local function line(f,a,b,th,col)
    local d = b - a
    local c = C(f)
    f.Position = UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2)
    f.Size = UDim2.fromOffset(d.Magnitude,th)
    f.Rotation = math.deg(math.atan2(d.Y,d.X))
    if c.col ~= col then c.col = col; f.BackgroundColor3 = col end
    if c.vis ~= true then c.vis = true; f.Visible = true end
end
local function txt(t, text, size, col, x, y)
    local c = C(t)
    if c.text ~= text then c.text = text; t.Text = text end
    if c.size ~= size then c.size = size; t.TextSize = size end
    if c.col ~= col then c.col = col; t.TextColor3 = col end
    x = math.floor(x+0.5); y = math.floor(y+0.5)
    if c.x ~= x or c.y ~= y then c.x, c.y = x, y; t.Position = UDim2.fromOffset(x,y) end
    if c.vis ~= true then c.vis = true; t.Visible = true end
end

local function newFrame()
    return mk("Frame",{BorderSizePixel=0,BackgroundColor3=WHITE,Visible=false,AnchorPoint=Vector2.new(.5,.5)},layer)
end
local function newText(w)
    return mk("TextLabel",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(w or 200,16),BackgroundTransparency=1,
        Font=Enum.Font.GothamBold,TextSize=12,TextStrokeTransparency=0,Visible=false},layer)
end

local R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local R6 = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}

-- medição da caixa pelos pontos do corpo (cabeça, pés, centro)
local BOX = {minX=0,maxX=0,minY=0,maxY=0,n=0,behind=false}
local LEG_NAMES = {"LeftFoot","RightFoot","Left Leg","Right Leg"}
local function boxReset()
    BOX.minX, BOX.maxX, BOX.minY, BOX.maxY = math.huge, -math.huge, math.huge, -math.huge
    BOX.n = 0
    BOX.behind = false
end
local function boxAdd(c, pos)
    local v = c:WorldToViewportPoint(pos)
    if v.Z <= 0 then BOX.behind = true return end
    local x, y = v.X, v.Y
    if x < BOX.minX then BOX.minX = x end
    if x > BOX.maxX then BOX.maxX = x end
    if y < BOX.minY then BOX.minY = y end
    if y > BOX.maxY then BOX.maxY = y end
    BOX.n = BOX.n + 1
end

local objs = {}
local function makeESP()
    local o = {box={}, skel={}, miss=0, vis=true, visT=0, hpShown=nil, char=nil, hidden=true}
    o.fill = newFrame(); o.fill.BackgroundTransparency = 0.85
    for i=1,8 do o.box[i] = newFrame() end
    o.hbg = newFrame(); o.hbg.BackgroundTransparency = 0.25
    mk("UICorner",{CornerRadius=UDim.new(1,0)},o.hbg)
    o.hfill = newFrame()
    mk("UICorner",{CornerRadius=UDim.new(1,0)},o.hfill)
    mk("UIGradient",{Color=ColorSequence.new(WHITE, Color3.fromRGB(165,165,165)),Rotation=90},o.hfill)
    o.tracer = newFrame()
    o.arrow = newFrame()
    o.name = newText(200)
    o.dist = newText(120)
    o.item = newText(160)
    o.hp = newText(34)
    return o
end
-- esconde tudo (menos a seta, e opcionalmente a distância)
local function hideParts(o, keepDist)
    for _,f in ipairs(o.box) do vis(f,false) end
    vis(o.fill,false); vis(o.hbg,false); vis(o.hfill,false); vis(o.tracer,false)
    vis(o.name,false); vis(o.item,false); vis(o.hp,false)
    if not keepDist then vis(o.dist,false) end
    for _,f in pairs(o.skel) do vis(f,false) end
    if o.hl and o.hl.Enabled then o.hl.Enabled = false end
end
local function hideAll(o)
    hideParts(o, false)
    vis(o.arrow,false)
    -- personagem morreu/sumiu: a animação da vida recomeça do zero ao renascer
    o.hpShown = nil
    o.char = nil
end
local function destroyESP(p)
    local o = objs[p]; if not o then return end
    for _,f in ipairs(o.box) do f:Destroy() end
    for _,f in pairs(o.skel) do f:Destroy() end
    o.fill:Destroy(); o.hbg:Destroy(); o.hfill:Destroy(); o.tracer:Destroy(); o.arrow:Destroy()
    o.name:Destroy(); o.dist:Destroy(); o.item:Destroy(); o.hp:Destroy()
    if o.hl then o.hl:Destroy() end
    objs[p] = nil
end
local function track(p)
    if p == LP or objs[p] then return end
    objs[p] = makeESP()
end
for _,p in ipairs(Players:GetPlayers()) do track(p) end
table.insert(conns, Players.PlayerAdded:Connect(track))
table.insert(conns, Players.PlayerRemoving:Connect(destroyESP))

local function setChams(o, char, on, col)
    if on then
        if not o.hl then
            o.hl = mk("Highlight",{FillTransparency=0.6,OutlineTransparency=0.1,
                DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Enabled=false},layer)
        end
        if o.hl.Adornee ~= char then o.hl.Adornee = char end
        if o.hl.FillColor ~= col then o.hl.FillColor = col; o.hl.OutlineColor = col end
        if not o.hl.Enabled then o.hl.Enabled = true end
    elseif o.hl and o.hl.Enabled then
        o.hl.Enabled = false
    end
end

-- seta na borda da tela apontando para o inimigo fora da tela
local function drawArrow(o, c, vp, pos, col, dist)
    local rel = c.CFrame:PointToObjectSpace(pos)
    local dx, dy = rel.X, -rel.Y
    local len = math.sqrt(dx*dx + dy*dy)
    if len < 0.001 then dx, dy, len = 0, 1, 1 end
    dx, dy = dx/len, dy/len
    local r = math.min(vp.X, vp.Y)*0.40
    local ccx, ccy = vp.X/2, vp.Y/2
    line(o.arrow,
        Vector2.new(ccx + dx*(r-10), ccy + dy*(r-10)),
        Vector2.new(ccx + dx*(r+10), ccy + dy*(r+10)), 5, col)
    if S.esp.dist then
        txt(o.dist, math.floor(dist).."m", 11, col, ccx + dx*(r-28), ccy + dy*(r-28))
    else
        vis(o.dist,false)
    end
end

local function updateESP(p, vp, c, now)
    local o = objs[p]
    if not o then track(p); o = objs[p]; if not o then return "hide" end end
    local char = p.Character
    if not (S.esp.on and char and isEnemy(p)) then return "hide" end
    local alive, hum = isAlive(char)
    if not alive then return "hide" end
    local root = getRoot(char)
    if not root then return "soft" end

    -- personagem novo (renasceu): recomeça a animação da vida
    if o.char ~= char then o.char = char; o.hpShown = nil end

    local rootPos = root.Position
    local dist = (rootPos - c.CFrame.Position).Magnitude
    if dist ~= dist or dist > S.esp.range then return "hide" end

    if now - o.visT > 0.12 then
        o.visT = now
        local ok, v = pcall(visible, root, char)
        if ok then o.vis = v end
    end
    local col
    if S.esp.teamColor and p.Team then
        col = p.TeamColor.Color
    else
        col = (S.esp.wall and not o.vis) and S.col.wall or S.col.esp
    end

    setChams(o, char, S.esp.chams, col)

    -- mede o corpo: cabeça (topo), pés/pernas e centro
    boxReset()
    local head = char:FindFirstChild("Head")
    local hasHead = head and head:IsA("BasePart")
    if hasHead then
        boxAdd(c, head.Position + Vector3.new(0, head.Size.Y*0.5 + 0.1, 0))
    end
    local legs = 0
    for i=1,4 do
        local lg = char:FindFirstChild(LEG_NAMES[i])
        if lg and lg:IsA("BasePart") then
            legs = legs + 1
            boxAdd(c, lg.Position - Vector3.new(0, lg.Size.Y*0.5, 0))
        end
    end
    boxAdd(c, rootPos)
    if (not hasHead) or legs == 0 then
        boxAdd(c, rootPos + Vector3.new(0,2.8,0))
        boxAdd(c, rootPos - Vector3.new(0, math.max(hum and hum.HipHeight or 2,2)+1, 0))
    end

    local onScreen = (not BOX.behind) and BOX.n >= 2
    if onScreen then
        local mx = (BOX.minX + BOX.maxX)/2
        local my = (BOX.minY + BOX.maxY)/2
        if mx < -60 or mx > vp.X+60 or my < -60 or my > vp.Y+60 then onScreen = false end
    end
    if not onScreen then
        if S.esp.arrows then
            hideParts(o, true)
            drawArrow(o, c, vp, rootPos, col, dist)
            return nil
        end
        return "hide"
    end
    vis(o.arrow,false)

    local cx = (BOX.minX + BOX.maxX)/2
    local midY = (BOX.minY + BOX.maxY)/2
    local h = math.max(BOX.maxY - BOX.minY + 4, 14)
    local w = math.max(BOX.maxX - BOX.minX + 4, h*0.45)
    local x1,y1,x2,y2 = cx-w/2, midY-h/2, cx+w/2, midY+h/2
    local t = h > 40 and 2 or 1
    local fs = math.clamp(math.floor(14 - dist/200),9,14)

    -- caixa (+ preenchimento)
    if S.esp.box then
        if S.esp.boxStyle == "Cantos" then
            local L = math.max(math.min(w,h)*0.28,3)
            local segs = {
                {x1,y1,L,t},{x1,y1,t,L},{x2-L,y1,L,t},{x2-t,y1,t,L},
                {x1,y2-t,L,t},{x1,y2-L,t,L},{x2-L,y2-t,L,t},{x2-t,y2-L,t,L},
            }
            for i=1,8 do local s=segs[i]; rect(o.box[i],s[1],s[2],s[3],s[4],col) end
        else
            local segs = {{x1,y1,w,t},{x1,y2-t,w,t},{x1,y1,t,h},{x2-t,y1,t,h}}
            for i=1,4 do local s=segs[i]; rect(o.box[i],s[1],s[2],s[3],s[4],col) end
            for i=5,8 do vis(o.box[i],false) end
        end
        if S.esp.fill then rect(o.fill,x1,y1,w,h,col) else vis(o.fill,false) end
    else
        for i=1,8 do vis(o.box[i],false) end
        vis(o.fill,false)
    end

    -- nome (em cima) | distância e item na mão (embaixo)
    if S.esp.name then txt(o.name, p.DisplayName, fs, col, cx, y1 - fs*0.5 - 3) else vis(o.name,false) end
    local yb = y2 + fs*0.5 + 3
    if S.esp.dist then
        txt(o.dist, math.floor(dist).."m", fs, col, cx, yb)
        yb = yb + fs + 1
    else vis(o.dist,false) end
    if S.esp.item then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then txt(o.item, "["..tool.Name.."]", math.max(fs-1,8), col, cx, yb) else vis(o.item,false) end
    else vis(o.item,false) end

    -- vida (barra fina, arredondada, animação suave e protegida)
    local hp, mx = readHealth(char, hum)
    if S.esp.health and hp and mx and mx > 0 then
        local fr = hp/mx
        if fr ~= fr then fr = 1 end            -- proteção contra valor inválido
        fr = math.clamp(fr,0,1)
        if o.hpShown == nil or o.hpShown ~= o.hpShown then o.hpShown = fr end
        o.hpShown = o.hpShown + (fr - o.hpShown)*0.3
        if math.abs(fr - o.hpShown) < 0.004 then o.hpShown = fr end
        local sf = math.clamp(o.hpShown,0,1)
        local bw = math.clamp(math.floor(h*0.03),2,4)
        local bh = h*0.9
        local by = midY - bh/2
        local left = (S.esp.healthSide == "Esquerda")
        local bx = left and (x1-bw-5) or (x2+5)
        rect(o.hbg,bx-1,by-1,bw+2,bh+2,Color3.fromRGB(10,10,10))
        local fh = math.max(bh*sf,2)
        rect(o.hfill,bx,by+bh-fh,bw,fh,Color3.fromHSV(sf*0.33,0.9,1))
        if S.esp.hpText and hp < 1e6 then
            local tx = left and (bx-19) or (bx+bw+19)
            txt(o.hp, tostring(math.floor(hp+0.5)), math.max(fs-3,8), WHITE, tx, math.clamp(by+bh-fh, by, by+bh))
        else vis(o.hp,false) end
    else
        vis(o.hbg,false); vis(o.hfill,false); vis(o.hp,false)
    end

    -- linha
    if S.esp.line then
        local oy = (S.esp.lineFrom=="Baixo") and vp.Y or ((S.esp.lineFrom=="Centro") and vp.Y/2 or 0)
        line(o.tracer,Vector2.new(vp.X/2,oy),Vector2.new(cx,y2),1.2,col)
    else vis(o.tracer,false) end

    -- esqueleto (frames criados só quando usados)
    if S.esp.skel then
        local list = char:FindFirstChild("UpperTorso") and R15 or R6
        for i=1,14 do
            local pr, okk = list[i], false
            if pr then
                local a,b = char:FindFirstChild(pr[1]), char:FindFirstChild(pr[2])
                if a and b then
                    local pa = c:WorldToViewportPoint(a.Position)
                    local pb = c:WorldToViewportPoint(b.Position)
                    if pa.Z>0 and pb.Z>0 then
                        local f = o.skel[i]
                        if not f then f = newFrame(); o.skel[i] = f end
                        line(f,Vector2.new(pa.X,pa.Y),Vector2.new(pb.X,pb.Y),1.2,col); okk=true
                    end
                end
            end
            if not okk and o.skel[i] then vis(o.skel[i],false) end
        end
    else
        for _,f in pairs(o.skel) do vis(f,false) end
    end
    return nil
end

---------------------------------------------------------------- MÓDULO AIM
local fovFrame = mk("Frame",{AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,BorderSizePixel=0,Visible=false},layer)
mk("UICorner",{CornerRadius=UDim.new(1,0)},fovFrame)
local fovStroke = mk("UIStroke",{Thickness=1.5,Color=WHITE},fovFrame)

local aimTarget = nil
local function aimPartOf(char)
    local pn = S.aim.part
    if pn == "Cabeça" then return char:FindFirstChild("Head") or getRoot(char)
    elseif pn == "Peito" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or getRoot(char)
    else return getRoot(char) end
end
local function evalTarget(p, c, center, cp)
    local char = p.Character
    if not char or not isEnemy(p) then return nil end
    if not isAlive(char) then return nil end
    local part = aimPartOf(char)
    if not part then return nil end
    local sp = c:WorldToViewportPoint(part.Position)
    if sp.Z <= 0 then return nil end
    local d = (Vector2.new(sp.X,sp.Y) - center).Magnitude
    return part, d, (part.Position - cp).Magnitude
end
local function aimbot(vp, c)
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local cp = c.CFrame.Position
    local part
    -- mantém o alvo atual enquanto ele continuar válido (menos tremedeira)
    if S.aim.sticky and aimTarget then
        local pt, d = evalTarget(aimTarget, c, center, cp)
        if pt and d <= S.aim.fov*1.25 and (not S.aim.wallCheck or visible(pt, aimTarget.Character)) then
            part = pt
        else
            aimTarget = nil
        end
    end
    if not part then
        local bestScore = math.huge
        for _,p in ipairs(Players:GetPlayers()) do
            local pt, d, d3 = evalTarget(p, c, center, cp)
            if pt and d <= S.aim.fov then
                local score = (S.aim.prio == "Distância") and d3 or d
                if score < bestScore and (not S.aim.wallCheck or visible(pt, p.Character)) then
                    bestScore = score; part = pt; aimTarget = p
                end
            end
        end
    end
    if part then
        local pos = part.Position
        if S.aim.predict > 0 then
            local ok, vel = pcall(function() return part.AssemblyLinearVelocity end)
            if ok and vel then pos = pos + vel * (S.aim.predict/100) * 0.25 end
        end
        local alpha = math.clamp(1 - S.aim.smooth/100, 0.02, 1)
        c.CFrame = c.CFrame:Lerp(CFrame.lookAt(cp, pos), alpha)
    else
        aimTarget = nil
    end
end

---------------------------------------------------------------- MÓDULO HITBOX (por blocos)
-- NÃO mexe em nenhuma parte real do inimigo. Para cada alvo é criado um BLOCO
-- separado, preso (ancorado) na posição da parte real e com o mesmo nome dela.
-- Desligou / morreu / aliado / longe: o bloco é apagado e o personagem
-- continua intacto.
local hbProx = {}   -- [parte real] = {px = bloco, box = contorno}

local function hbDrop(src)
    local e = hbProx[src]
    if not e then return end
    if e.px then pcall(function() e.px:Destroy() end) end
    if e.box then pcall(function() e.box:Destroy() end) end
    hbProx[src] = nil
end

-- lista de {parte real, tamanho do bloco, nome, mostrar contorno}
local function hbTargets(char)
    local list, mode = {}, S.hb.mode
    local hs, bs = S.hb.head, S.hb.body
    local headSz = Vector3.new(hs, hs, hs)
    local bodySz = Vector3.new(bs, bs*1.5, bs)
    local wantHead = (mode == "Cabeça" or mode == "Cabeça+Corpo" or mode == "Tudo")
    local wantRoot = (mode == "Corpo" or mode == "Cabeça+Corpo" or mode == "Tudo")
    local wantTorso = (mode == "Tronco" or mode == "Tudo")
    if wantHead then
        local h = char:FindFirstChild("Head")
        if h and h:IsA("BasePart") then list[#list+1] = {h, headSz, h.Name, true} end
    end
    if wantRoot then
        local r = char:FindFirstChild("HumanoidRootPart") or getRoot(char)
        if r and r:IsA("BasePart") then list[#list+1] = {r, bodySz, r.Name, true} end
    end
    if wantTorso then
        local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if t and t:IsA("BasePart") then list[#list+1] = {t, bodySz, t.Name, mode == "Tronco"} end
    end
    return list
end

local function hbFollow()
    for src,e in pairs(hbProx) do
        if src.Parent and e.px and e.px.Parent then
            e.px.CFrame = src.CFrame
        end
    end
end

local function hitboxStep()
    if not S.hb.on and next(hbProx) == nil then return end
    local c = cam()
    if not c then return end
    local active = {}
    if S.hb.on then
        local cp = c.CFrame.Position
        for _,p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if char and isEnemy(p) and isAlive(char) then
                local root = getRoot(char)
                if root and (root.Position - cp).Magnitude <= S.hb.range then
                    for _,t in ipairs(hbTargets(char)) do active[t[1]] = t end
                end
            end
        end
    end
    for src in pairs(hbProx) do
        if (not src.Parent) or (not active[src]) then hbDrop(src) end
    end
    local tr = math.clamp(S.hb.trans,0,10)/10
    local col = S.col.hb
    for src,t in pairs(active) do
        local e = hbProx[src]
        if e and ((not e.px) or e.px.Parent ~= src.Parent) then hbDrop(src); e = nil end
        if not e then
            local px = mk("Part",{Name=t[3],Anchored=true,CanCollide=false,CanTouch=true,CanQuery=true,
                CastShadow=false,Size=t[2],Transparency=tr,Color=col,CFrame=src.CFrame})
            pcall(function() px:SetAttribute("NXProxy", true) end)
            px.Parent = src.Parent
            e = {px=px}
            hbProx[src] = e
        end
        local px = e.px
        if px.Size ~= t[2] then px.Size = t[2] end
        if px.Transparency ~= tr then px.Transparency = tr end
        if px.Color ~= col then px.Color = col end
        px.CFrame = src.CFrame
        if S.hb.box and t[4] then
            if (not e.box) or not e.box.Parent then
                e.box = mk("SelectionBox",{Adornee=px,LineThickness=0.03,SurfaceTransparency=0.88},boxFolder)
            end
            if e.box.Color3 ~= col then e.box.Color3 = col; e.box.SurfaceColor3 = col end
        elseif e.box then
            pcall(function() e.box:Destroy() end)
            e.box = nil
        end
    end
end


---------------------------------------------------------------- LOOP PRINCIPAL
pcall(refreshTeams)
local lastScan, lastTeam = 0, 0
local fovC = {}

local function onFrame()
    local c = cam()
    if not c then return end
    local vp = c.ViewportSize
    local now = tick()

    -- círculo do FOV
    local showFov = S.aim.showFov
    if fovC.v ~= showFov then fovC.v = showFov; fovFrame.Visible = showFov end
    if showFov then
        local cx, cy, r = math.floor(vp.X/2), math.floor(vp.Y/2), S.aim.fov
        if fovC.x ~= cx or fovC.y ~= cy then fovC.x, fovC.y = cx, cy; fovFrame.Position = UDim2.fromOffset(cx,cy) end
        if fovC.r ~= r then fovC.r = r; fovFrame.Size = UDim2.fromOffset(r*2, r*2) end
        if fovC.c ~= S.col.fov then fovC.c = S.col.fov; fovStroke.Color = S.col.fov end
    end

    if now - lastScan > 2 then
        lastScan = now
        for _,p in ipairs(Players:GetPlayers()) do track(p) end
    end

    if now - lastTeam > 1.0 then
        lastTeam = now
        pcall(refreshTeams)
        local t = LP.Team
        teamLbl.Text = "Método: "..(teamMethod or "nenhum (marque manual)")
        teamSw.BackgroundColor3 = t and t.TeamColor.Color or Color3.fromRGB(80,80,80)
        teamCount.Text = "Aliados ignorados: "..(S.team.ignore and teamAllyCount or 0)
        for _,r in pairs(plRefresh) do pcall(r) end
    end

    pcall(hbFollow)

    -- aim primeiro, depois ESP (assim o ESP usa a câmera já ajustada)
    if S.aim.on then pcall(aimbot, vp, c) end

    for p,o in pairs(objs) do
        local ok, res = pcall(updateESP, p, vp, c, now)
        if ok and res == nil then
            o.miss = 0
            o.hidden = false
        elseif ok and res == "hide" then
            o.miss = 0
            if not o.hidden then hideAll(o); o.hidden = true end
        else
            o.miss = o.miss + 1
            if o.miss > 8 and not o.hidden then hideAll(o); o.hidden = true end
        end
    end
end


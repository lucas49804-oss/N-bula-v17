-- SLIDER: arraste a barra para mudar o valor
local function sliderRow(pg,text,tbl,key,min,max,step,onChange)
    step = step or 1
    local f = row(pg,48)
    label(f,text,.65,2)
    local valLbl = mk("TextLabel",{BackgroundTransparency=1,AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-10,0,4),
        Size=UDim2.fromOffset(90,16),Text="",TextColor3=CYAN,Font=Enum.Font.GothamBold,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Right},f)
    local bar = mk("Frame",{Position=UDim2.new(0,12,1,-16),Size=UDim2.new(1,-24,0,8),
        BackgroundColor3=BG,BorderSizePixel=0},f)
    mk("UICorner",{CornerRadius=UDim.new(1,0)},bar)
    local fill = mk("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=WHITE,BorderSizePixel=0},bar)
    mk("UICorner",{CornerRadius=UDim.new(1,0)},fill)
    grad(fill,0)
    local knob = mk("Frame",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(18,18),Position=UDim2.new(0,0,.5,0),
        BackgroundColor3=WHITE,BorderSizePixel=0,ZIndex=3},bar)
    mk("UICorner",{CornerRadius=UDim.new(1,0)},knob)
    table.insert(menuStrokes, mk("UIStroke",{Color=S.col.menu1,Thickness=2},knob))
    local hit = mk("TextButton",{BackgroundTransparency=1,Text="",Position=UDim2.new(0,0,0,-14),
        Size=UDim2.new(1,0,1,28),ZIndex=4},bar)

    local function render()
        local a = math.clamp((tbl[key]-min)/(max-min),0,1)
        fill.Size = UDim2.new(a,0,1,0)
        knob.Position = UDim2.new(a,0,.5,0)
        valLbl.Text = tostring(tbl[key])
    end
    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
        local v = min + a*(max-min)
        v = math.floor(v/step+0.5)*step
        tbl[key] = math.clamp(v,min,max)
        render()
        if onChange then onChange() end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            activeSlide = setFromX
            setFromX(i.Position.X)
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End and activeSlide==setFromX then activeSlide = nil end
            end)
        end
    end)
    render()
    table.insert(uiRefresh, render)
    return render
end


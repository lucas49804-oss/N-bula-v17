    local function cfgEncode()
        local out = {}
        for g,t in pairs(S) do
            out[g] = {}
            for k,v in pairs(t) do
                if typeof(v) == "Color3" then
                    out[g][k] = {__c={math.floor(v.R*255+0.5), math.floor(v.G*255+0.5), math.floor(v.B*255+0.5)}}
                else
                    out[g][k] = v
                end
            end
        end
        return HttpService:JSONEncode(out)
    end
    local function cfgApply(data)
        for g,t in pairs(data) do
            if type(t) == "table" and S[g] then
                for k,v in pairs(t) do
                    local cur = S[g][k]
                    if cur ~= nil then

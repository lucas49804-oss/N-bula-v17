-- vida real (Humanoid ou valores guardados pelo jogo) - só aceita números válidos
local HP_NAMES  = {"Health","HP","Vida"}
local MAX_NAMES = {"MaxHealth","MaxHP","VidaMax"}
local function readHealth(char, hum)
    local hp = hum and hum.Health
    local mx = hum and hum.MaxHealth
    for i=1,3 do
        local v = char:GetAttribute(HP_NAMES[i])
        if type(v) == "number" and v == v and v > 0 then hp = v break end
    end
    for i=1,3 do
        local v = char:GetAttribute(MAX_NAMES[i])
        if type(v) == "number" and v == v and v > 0 then mx = v break end
    end
    if (not hp) or hp ~= hp then return nil end
    if (not mx) or mx ~= mx or mx <= 0 or mx >= 1e6 then mx = math.max(hp, 100) end
    return hp, mx
end

-- checagem de parede (ignora partes transparentes / sem colisão)
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true
local function visible(part, char)
    local c = cam()
    if not c then return true end
    local origin = c.CFrame.Position
    local dir = part.Position - origin
    local ignore = {char}
    local mine = LP.Character
    if mine then table.insert(ignore, mine) end
    for _=1,6 do
        rp.FilterDescendantsInstances = ignore
        local r = workspace:Raycast(origin, dir, rp)
        if not r then return true end
        local h = r.Instance
        if h.Transparency >= 0.95 or not h.CanCollide then
            table.insert(ignore, h)
        else
            return false
        end
    end
    return false
end

local function makeDraggable(handle, target, onTap, canDrag)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    table.insert(conns, handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true moved=false dragStart=i.Position startPos=target.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then
                    dragging=false
                    if onTap and not moved then onTap() end
                end
            end)
        end
    end))
    table.insert(conns, UIS.InputChanged:Connect(function(i)
        if dragging and (not canDrag or canDrag())
            and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then
            local d = i.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
            end
        end
    end))
end

---------------------------------------------------------------- MÓDULO TIME
-- Procura "pistas" de time (Team, atributos, valores, pasta do personagem).
-- Só usa uma pista se ela separa mesmo os jogadores em grupos, então nunca
-- esconde todo mundo por engano. Também ignora amigos e aceita marcação manual.
local OVER = {}          -- [UserId] = true (aliado) / false (inimigo)
local allyCache = {}     -- [player] = true se for aliado
local friendCache = {}
local teamMethod = nil
local teamAllyCount = 0

local function teamLike(n)
    n = string.lower(tostring(n))
    if n:find("team") or n:find("equipe") or n:find("squad") or n:find("faction") then return true end
    return n=="time" or n=="timeid" or n=="timename" or n=="side" or n=="lado"
end

local function candidates(p)
    local list, map = {}, {}
    local function add(k,v)
        if v == nil or v == "" or v == "Neutral" then return end
        if map[k] ~= nil then return end
        map[k] = v
        list[#list+1] = {k,v}
    end
    local function scan(inst, tag)
        if not inst then return end
        for n,v in pairs(inst:GetAttributes()) do
            if teamLike(n) then add(tag.." atributo "..n, v) end
        end
        for _,ch in ipairs(inst:GetChildren()) do
            if ch:IsA("ValueBase") and teamLike(ch.Name) then add(tag.." valor "..ch.Name, ch.Value) end
        end
    end
    if p.Team then add("Team do Roblox", p.Team) end
    scan(p, "Player")
    scan(p:FindFirstChild("leaderstats"), "Stats")
    local char = p.Character
    if char then
        scan(char, "Char")
        local par = char.Parent
        if par and par ~= workspace then add("Pasta do personagem", par) end
    end
    return list, map
end

local function refreshTeams()
    local mine = candidates(LP)
    local maps = {}
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local _, m = candidates(p)
            maps[p] = m
        end
    end
    local method
    for _,e in ipairs(mine) do
        for _,m in pairs(maps) do
            local v = m[e[1]]
            if v ~= nil and v ~= e[2] then method = e break end
        end
        if method then break end
    end
    teamMethod = method and method[1] or nil
    local n = 0
    for p,m in pairs(maps) do
        local ally = false
        if S.team.auto and method then
            local v = m[method[1]]
            ally = (v ~= nil and v == method[2])
        end
        if S.team.friends then
            if friendCache[p.UserId] == nil then
                friendCache[p.UserId] = false
                task.spawn(function()
                    local ok, r = pcall(function() return LP:IsFriendsWith(p.UserId) end)
                    friendCache[p.UserId] = (ok and r) and true or false
                end)
            end
            if friendCache[p.UserId] then ally = true end
        end
        local ov = OVER[p.UserId]
        if ov ~= nil then ally = ov end
        allyCache[p] = ally
        if ally then n = n + 1 end
    end
    for p in pairs(allyCache) do
        if not maps[p] then allyCache[p] = nil end
    end
    teamAllyCount = n
end

local function isEnemy(p)
    if p == LP then return false end
    if S.team.ignore and allyCache[p] == true then return false end
    return true
end

